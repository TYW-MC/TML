<local:MyPageRight
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL"
    x:Class="PageInstanceBedrockPack"
    PanScroll="PanBack">
    <Grid>
        <Grid x:Name="PanAllBack">
            <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
                <StackPanel x:Name="PanMain" Margin="25,10,25,10">
                    <local:MyCard Margin="0,15,0,15" x:Name="PanManage">
                        <Grid Margin="15,15,0,15" Height="35">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                            </Grid.ColumnDefinitions>
                            <local:MyButton x:Name="BtnOpen" Grid.Column="0" MinWidth="110" Text="打开文件夹" Padding="13,0" Margin="0,0,15,0" HorizontalAlignment="Left" ColorType="Highlight" />
                            <local:MyButton x:Name="BtnImport" Grid.Column="1" MinWidth="110" Text="导入包" Padding="13,0" Margin="0,0,15,0" HorizontalAlignment="Left" />
                            <local:MyButton x:Name="BtnRefresh" Grid.Column="2" MinWidth="110" Text="刷新" Padding="13,0" Margin="0,0,15,0" HorizontalAlignment="Left" />
                        </Grid>
                    </local:MyCard>
                    <local:MyCard x:Name="PanListBack" VerticalAlignment="Top" Margin="0,0,0,14" Title=" " MinHeight="55">
                        <StackPanel Margin="20,44,18,22" Name="PanList" VerticalAlignment="Top" />
                    </local:MyCard>
                    <TextBlock x:Name="LabNote" Margin="4,0,20,20" TextWrapping="Wrap" Opacity="0.6" FontSize="12" />
                </StackPanel>
            </local:MyScrollViewer>
            <local:MyCard HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40" x:Name="PanEmpty" Visibility="Collapsed">
                <StackPanel Margin="20,17">
                    <TextBlock Margin="0,0,0,9" HorizontalAlignment="Center" Text="尚未安装资源包" FontSize="19" UseLayoutRounding="True" SnapsToDevicePixels="True" Foreground="{DynamicResource ColorBrush3}" x:Name="LabEmptyTitle" />
                    <Rectangle HorizontalAlignment="Stretch" Height="2" Fill="{DynamicResource ColorBrush3}" />
                    <TextBlock Margin="10,10,10,0" TextWrapping="Wrap" x:Name="LabEmptyDesc" Text="你可以导入 .mcpack 或 .mcaddon 文件，也可以直接把包放进游戏的对应文件夹。" />
                    <Grid Margin="15,20,0,5" Height="35" HorizontalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                        </Grid.ColumnDefinitions>
                        <local:MyButton Height="35" HorizontalAlignment="Center" Grid.Column="0" x:Name="BtnHintImport" MinWidth="140" Text="导入包" Margin="0,0,17,0" Padding="13,0" ColorType="Highlight" />
                        <local:MyButton Height="35" HorizontalAlignment="Center" Grid.Column="1" x:Name="BtnHintOpen" MinWidth="140" Text="打开文件夹" Margin="0,0,17,0" Padding="13,0" />
                    </Grid>
                </StackPanel>
            </local:MyCard>
        </Grid>
    </Grid>
</local:MyPageRight>
