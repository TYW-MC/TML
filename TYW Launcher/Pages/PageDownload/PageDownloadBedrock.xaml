<local:MyPageRight
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" x:Class="PageDownloadBedrock"
    PanScroll="PanBack">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <Grid Margin="25,10,25,25">
            <StackPanel>

                <TextBlock Text="基岩版" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource ColorBrush1}" Margin="0,0,0,8" />
                <local:MyHint Text="版本数据与下载源来自 mcappx.com，仅提供可安装的 UWP（Microsoft Store）版本，下载后使用系统组件自动安装。" Theme="Blue" Margin="0,0,0,15" />

                <local:MyCard Title="已安装" Margin="0,0,0,15" x:Name="CardInstalled">
                    <Grid Margin="18,10,18,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="LabInstalled" Text="正在检测已安装的基岩版……" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <local:MyButton x:Name="BtnLaunch" Grid.Column="1" Text="启动游戏" Width="110" Padding="9,4" Margin="15,0,0,0" ColorType="Highlight" Visibility="Collapsed" />
                    </Grid>
                </local:MyCard>

                <local:MyCard Title="选择版本下载" x:Name="CardDownload" UseAnimation="False">
                    <StackPanel Margin="18,8,18,18" x:Name="PanListBack">
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,10">
                            <local:MyRadioBox x:Name="RadioRetail" Text="正式版" Checked="True" Margin="0,0,22,0" />
                            <local:MyRadioBox x:Name="RadioPreview" Text="预览版" Margin="0,0,22,0" />
                            <local:MyButton x:Name="BtnRefresh" Text="刷新列表" Width="100" Padding="9,3" />
                        </StackPanel>
                        <TextBlock x:Name="LabLoading" Text="正在加载版本列表……" Visibility="Collapsed" Opacity="0.6" Margin="0,6,0,6" />
                        <local:MyHint x:Name="HintList" Theme="Red" Visibility="Collapsed" Margin="0,4,0,4" />
                        <StackPanel x:Name="PanList" />
                    </StackPanel>
                </local:MyCard>

            </StackPanel>
        </Grid>
    </local:MyScrollViewer>
</local:MyPageRight>
